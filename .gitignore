# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated iOS folder
/ios

# Android Gradle build outputs and machine-local configuration. The Android
# source project itself is versioned because F-Droid builds from the upstream
# source tag.
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/.cxx/
/android/app/.cxx/
/android/local.properties
/android/app/debug.keystore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs
*.log

# OS
Thumbs.db

# Build files
*.tgz
*.tar.gz
.cache/
.artifacts/
modules/pocket-hermes-supervisor/android/src/main/python/wheels/
modules/pocket-hermes-supervisor/android/src/main/python/vendor/pydantic-core/*.whl

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/
.project-config.json

# Additional ignored runtime artifacts
.cache/
.manus-logs/
# fastlane/
# metadata/

# Module build outputs
**/build/

# Cargo directory sources may legitimately contain `build/` source directories
# declared in their .cargo-checksum.json manifests. Keep those vendored inputs
# versioned while retaining the general build-output rule above.
!third_party/pydantic-core/vendor/**/build/
!third_party/pydantic-core/vendor/**/build/**
